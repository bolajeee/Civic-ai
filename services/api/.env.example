# Server Configuration
NODE_ENV=development
PORT=3000

# Database and Supabase (defaults match local Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT — access tokens (short-lived, 15 min)
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=replace-with-a-random-secret
# JWT_SECRET is required when NODE_ENV=production.

# Comma-separated browser origins allowed by CORS (e.g. the government dashboard).
# Unset: any origin in development, none in production.
CORS_ORIGINS=

# Set true behind a reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=false

# Protects GET /api/metrics. Leave blank to disable the metrics endpoint.
METRICS_TOKEN=

# Citizen password recovery. The pepper must be secret and stable. Resend is
# used only by the API; in non-production, missing email settings log/return the
# code for local testing.
PASSWORD_RESET_PEPPER=replace-with-a-separate-random-secret
RESEND_API_KEY=
EMAIL_FROM="CivicAI <no-reply@example.com>"

# Comma-separated OAuth client IDs accepted as ID-token audiences. Use the same
# Google web client ID as GOOGLE_SERVER_CLIENT_ID in the Flutter build (and the
# iOS client as GOOGLE_CLIENT_ID when building for iOS). Apple
# normally needs both the iOS bundle ID and Services ID.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.example.civicReport

# Refresh tokens — TTL is set in src/lib/tokens.ts (default 30 days)
# No extra env var needed unless you want to override TTL at runtime.

# Phase 3 image classification (server-side only; API usage is billed).
# Apply the report_ai_analyses migration before enabling this.
AI_CLASSIFICATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna
AI_CLASSIFICATION_MIN_CONFIDENCE=0.65

# Independent severity analysis (billed image inference; apply severity migration first).
# Enabling also queues the existing report backlog at startup.
AI_SEVERITY_ENABLED=false
OPENAI_SEVERITY_MODEL=gpt-6-luna
AI_SEVERITY_MIN_CONFIDENCE=0.65

# Phase 3 embeddings (reuses OPENAI_API_KEY; API usage is billed).
# Apply the report_embeddings migration before enabling this.
AI_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 3 visual embeddings through Vertex AI (billed API usage).
# Store service-account private keys on one line with literal \n separators.
AI_IMAGE_EMBEDDINGS_ENABLED=false
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_CLIENT_EMAIL=
VERTEX_AI_PRIVATE_KEY=
VERTEX_AI_IMAGE_EMBEDDING_MODEL=multimodalembedding@001

# Phase 3 duplicate candidates (database-only, no API cost). Needs embeddings
# enabled and the report_duplicate_candidates migration applied.
AI_DUPLICATE_DETECTION_ENABLED=false
AI_DUPLICATE_RADIUS_METERS=200
AI_DUPLICATE_MIN_SCORE=0.6

# Issue clustering (database-only). Apply the issue_clusters migration first.
# Consumes completed duplicate searches, including the existing backlog.
AI_CLUSTERING_ENABLED=false
AI_CLUSTER_AUTO_MIN_SCORE=0.85
AI_CLUSTER_AMBIGUITY_MARGIN=0.05

# Cluster priority (database-only, no model calls). Apply cluster_priorities migration first.
# Missing geographic context stays unavailable until sourced values are supplied.
AI_PRIORITY_ENABLED=false

# Citizen push notifications through Firebase Cloud Messaging.
# Store service-account private keys on one line with literal \n separators.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
